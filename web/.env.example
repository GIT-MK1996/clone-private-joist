# Required: random string, min. 32 characters (encrypts Mollie keys). Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Public URL in production, e.g. https://klusnota.nl (needed for links in emails and Mollie webhooks)
APP_URL=

# Database: local file by default; Turso in production
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Email via Resend. Without these, login links and emails are printed in the server log (development only).
RESEND_API_KEY=
EMAIL_FROM="Klusnota <noreply@mail.mkstudios.nl>"

# Klusnota subscription (hard paywall), billed on MK Studio's own Stripe account.
# Secret key of the MK Studio account (sk_test_ first, sk_live_ after KvK). Not the contractor keys.
BILLING_STRIPE_KEY=
BILLING_TRIAL_DAYS=14
# Optional: fixed Stripe price ids; without them the app sends €12/month and €120/year inline.
BILLING_PRICE_MONTH=
BILLING_PRICE_YEAR=
# Optional: Stripe tax rate id (txr_...) for 21% btw, once you have a btw number.
BILLING_TAX_RATE=
# Set to 1 to switch the paywall off (e.g. a demo environment).
BILLING_DISABLED=

# Optional: "Doorgaan met Google". OAuth client (Web application) from Google Cloud Console.
# Redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
