# Required: random string, min. 32 characters (encrypts Mollie keys). Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Public URL in production, e.g. https://werkbon.nl (needed for links in emails and Mollie webhooks)
APP_URL=

# Database: local file by default; Turso in production
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Email via Resend. Without these, login links and emails are printed in the server log (development only).
RESEND_API_KEY=
EMAIL_FROM="Werkbon <noreply@jouwdomein.nl>"
